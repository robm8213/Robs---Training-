{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "api.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api",
      "dest": "/api.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api?action=daily-reminders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api?action=auto-create-week",
      "schedule": "0 16 * * 6"
    }
  ]
}
